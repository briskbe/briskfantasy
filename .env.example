# Transactional email for the contact form, via Resend (https://resend.com).
# Without RESEND_API_KEY the form still submits and the lead is logged to the
# server console, so a local checkout works with no setup.
#
# The From address must be on a domain verified in the Resend dashboard,
# otherwise every send is rejected with a 403. The Resend integration provides
# the verified sender as RESEND_FROM; set CONTACT_FROM only to override it.
RESEND_API_KEY=
RESEND_FROM=
CONTACT_TO=info@brisk.be
CONTACT_FROM=

# Only needed to re-run scripts/fetch-client-logos.mjs. The logos it downloads are
# committed to public/logos, so the running site never needs this key.
BRANDFETCH_API_KEY=

# Optional ownership verification tokens (content value, not the full meta tag).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
