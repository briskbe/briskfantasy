# Transactional email for the contact form, via Resend (https://resend.com).
# Without RESEND_API_KEY the form still submits and the lead is logged to the
# server console, so a local checkout works with no setup.
#
# CONTACT_FROM must be on a domain verified in the Resend dashboard, otherwise
# every send is rejected. brisk.be is verified.
RESEND_API_KEY=
CONTACT_TO=info@brisk.be
CONTACT_FROM="Brisk <hallo@brisk.be>"

# Only needed to re-run scripts/fetch-client-logos.mjs. The logos it downloads are
# committed to public/logos, so the running site never needs this key.
BRANDFETCH_API_KEY=
