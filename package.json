    "cms:bootstrap": "node --env-file-if-exists=.env.local scripts/cms-bootstrap.mjs",
    "cms:test:auth": "node --env-file-if-exists=.env.local --import ./scripts/cms-test-loader.mjs --import tsx scripts/cms-auth-smoke.mts",
